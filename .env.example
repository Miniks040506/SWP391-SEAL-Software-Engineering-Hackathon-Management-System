# Core backend configuration
DB_URL=jdbc:postgresql://localhost:5432/seal_hackathon
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# Social login applications (not submission-provider authorization)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts OAuth access and refresh tokens stored by the backend.
# Generate a value with: openssl rand -base64 32
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
PROVIDER_OAUTH_COOKIE_SECURE=false

# Separate least-privilege Google Drive submission application
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/google-drive/callback
GOOGLE_DRIVE_PICKER_API_KEY=
GOOGLE_DRIVE_APP_ID=
SUBMISSION_GOOGLE_DRIVE_ENABLED=false

# GitHub submission remains disabled until its separate user OAuth app is configured.
# GITHUB_TOKEN is only an optional public-repository metadata fallback.
GITHUB_TOKEN=
SUBMISSION_GITHUB_ENABLED=false
REPO_METADATA_ENABLED=true

# Submission rules and internal snapshot storage
SUBMISSION_UPLOAD_MAX_SIZE_MB=25
SUBMISSION_UPLOAD_MAX_FILES=10
SUBMISSION_STORAGE_PROVIDER=AWS_S3
SUBMISSION_LOCAL_FILE_ENABLED=false
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
